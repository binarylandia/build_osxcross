#!/usr/bin/env bash
#
# Usage: scripts/test-toolchain <toolchain folder>
#
# Compile and link C, C++, and assembly for every architecture of an osxcross
# toolchain, and fail unless each output is a Mach-O file of that architecture
# with the deployment target of the toolchain. A C program that calls
# __builtin_available also checks that compiler-rt links.
#
set -euo pipefail

function fail() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

# Print the minimum macOS version of a Mach-O file (LC_BUILD_VERSION, or
# LC_VERSION_MIN_MACOSX for old deployment targets).
function minos() {
  llvm-otool -l "${1}" | awk '
    /cmd LC_BUILD_VERSION/ { build = 1 }
    build && $1 == "minos" { print $2; exit }
    /cmd LC_VERSION_MIN_MACOSX/ { vmin = 1 }
    vmin && $1 == "version" { print $2; exit }
  '
}

function check_binary() {
  local file="${1}"
  local arch="${2}"
  local expected_minos="${3}"
  local archs
  archs="$(llvm-lipo -archs "${file}" | xargs)"
  [[ "${archs}" == "${arch}" ]] || fail "${file} is built for '${archs}', not ${arch}"
  local actual_minos
  actual_minos="$(minos "${file}")"
  [[ "${actual_minos}" == "${expected_minos}" ]] || fail "${file} targets macOS ${actual_minos}, not ${expected_minos}"
}

# Fail unless every Linux program of the toolchain runs with glibc 2.17 and
# needs no shared C++ or GCC runtime.
function check_host_programs() {
  local toolchain="${1}"
  local file
  while IFS= read -r -d '' file; do
    [[ "$(od -An -tx1 -N4 "${file}")" == ' 7f 45 4c 46' ]] || continue
    if llvm-readelf --dynamic "${file}" | grep -E '\(NEEDED\).*\[(libstdc\+\+|libgcc_s|libc\+\+)'; then
      fail "${file} needs a shared C++ or GCC runtime"
    fi
    local newest
    newest="$(llvm-readelf --version-info "${file}" | grep -oE 'GLIBC_[0-9]+(\.[0-9]+)+' | sed 's/^GLIBC_//' | sort -V | tail -1)"
    if [[ -n "${newest}" && "$(printf '%s\n2.17\n' "${newest}" | sort -V | tail -1)" != "2.17" ]]; then
      fail "${file} needs glibc ${newest}, newer than 2.17"
    fi
  done < <(find "${toolchain}/bin" -type f -print0)
}

main() {
  local toolchain="${1:?toolchain folder}"
  check_host_programs "${toolchain}"
  export PATH="${toolchain}/bin:${PATH}"
  local target
  target="$(osxcross-conf | sed -n 's/^export OSXCROSS_TARGET="\{0,1\}\([^"]*\)"\{0,1\}$/\1/p')"
  local version_min
  version_min="$(osxcross-conf | sed -n 's/^export OSXCROSS_OSX_VERSION_MIN="\{0,1\}\([^"]*\)"\{0,1\}$/\1/p')"
  local archs
  archs="$(osxcross-conf | sed -n 's/^export OSXCROSS_SUPPORTED_ARCHS="\{0,1\}\([^"]*\)"\{0,1\}$/\1/p')"
  [[ -n "${target}" && -n "${version_min}" && -n "${archs}" ]] || fail "osxcross-conf does not name the target, deployment target, and architectures"

  test_dir="$(mktemp -d)"
  trap 'rm -rf -- "${test_dir}"' EXIT

  cat >"${test_dir}/main.c" <<'EOF'
#include <stdio.h>
int main(void) {
  if (__builtin_available(macOS 10.15, *)) {
    puts("10.15 or later");
  }
  return 0;
}
EOF
  cat >"${test_dir}/main.cpp" <<'EOF'
#include <iostream>
#include <stdexcept>
#include <vector>
int main() {
  std::vector<int> v{1, 2, 3};
  try {
    throw std::runtime_error("expected");
  } catch (const std::exception &e) {
    std::cout << e.what() << v.size() << "\n";
  }
  return 0;
}
EOF
  cat >"${test_dir}/add.s" <<'EOF'
.text
.globl _add
_add:
EOF

  local arch
  for arch in ${archs}; do
    local expected_minos="${version_min}"
    if [[ "${arch}" == arm64* ]] && [[ "$(printf '%s\n11.0\n' "${version_min}" | sort -V | head -1)" != "11.0" ]]; then
      expected_minos="11.0"
    fi
    local cc="${arch}-apple-${target}-clang"
    local cxx="${arch}-apple-${target}-clang++"
    "${cc}" -O2 "${test_dir}/main.c" "${toolchain}/compiler-rt/lib/darwin/libclang_rt.osx.a" -o "${test_dir}/c-${arch}"
    check_binary "${test_dir}/c-${arch}" "${arch}" "${expected_minos}"
    "${cxx}" -O2 -stdlib=libc++ "${test_dir}/main.cpp" -o "${test_dir}/cxx-${arch}"
    check_binary "${test_dir}/cxx-${arch}" "${arch}" "${expected_minos}"
    "${cc}" -c "${test_dir}/add.s" -o "${test_dir}/add-${arch}.o"
    "${arch}-apple-${target}-ar" rcs "${test_dir}/libadd-${arch}.a" "${test_dir}/add-${arch}.o"
    "${arch}-apple-${target}-nm" "${test_dir}/libadd-${arch}.a" | grep -q ' T _add' || fail "ar or nm of ${arch} lost the symbol _add"
    printf 'ok %s-apple-%s, macOS %s\n' "${arch}" "${target}" "${expected_minos}"
  done
}

main "$@"
